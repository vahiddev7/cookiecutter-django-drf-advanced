# Django settings
# -----------------------------------------------------------------------------
# Generate a strong secret key with:
# python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Allowed hosts. Set this to your deployment's hostnames, comma-separated.
# Example: ALLOWED_HOSTS=example.com,www.example.com
# Keep empty until configured; do not use "*" in production.
ALLOWED_HOSTS=

# Database settings
# -----------------------------------------------------------------------------
# SQLite is used when database_engine=sqlite.
#
# PostgreSQL example:
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432
#
# MySQL example:
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=3306
#
# SQL Server example:
# DB_NAME=your_db_name
# DB_USER=sa
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=1433
# Only enable for local/dev SQL Server instances with self-signed certificates.
# Production should use a valid certificate and leave this disabled.
# DB_TRUST_SERVER_CERTIFICATE=False

# Internationalization
# -----------------------------------------------------------------------------
LANGUAGE_CODE=fa
TIME_ZONE=UTC

# Celery
# -----------------------------------------------------------------------------
# Uncomment and configure these only when use_celery=y.
#
# Redis:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
#
# RabbitMQ:
# Generate unique credentials for each deployment; do not use example values.
# RABBITMQ_DEFAULT_USER=your_unique_rabbitmq_user
# RABBITMQ_DEFAULT_PASS=replace_with_a_long_random_password
# CELERY_BROKER_URL=amqp://your_unique_rabbitmq_user:replace_with_a_long_random_password@broker:5672//
# CELERY_RESULT_BACKEND=rpc://

# Production HTTPS/security settings
# Set SECURE_SSL_REDIRECT=True only when all requests arrive over HTTPS.
# If TLS terminates at a trusted proxy, also set TRUST_PROXY_SSL_HEADER=True
# and ensure the proxy overwrites X-Forwarded-Proto (never pass client values).
SECURE_SSL_REDIRECT=False
TRUST_PROXY_SSL_HEADER=False

# Enable HSTS only after HTTPS is fully working for this domain.
# Start with a short duration, then increase (e.g. 31536000 for one year).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Cross-origin browser access
# Comma-separated full origins, including scheme and optional port.
# Leave empty unless a separate frontend must call this API from a browser.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False

# Add trusted origins only when cross-origin cookie/session-based CSRF is needed.
# Values must include the scheme, e.g. https://frontend.example.com
CSRF_TRUSTED_ORIGINS=

# Logging and error monitoring
# -----------------------------------------------------------------------------
# LOG_LEVEL controls console logging (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LOG_LEVEL=INFO

# Sentry is optional. Configure a DSN only when use_sentry=y was selected.
# Keep the DSN secret and configure it in the deployment environment.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Start with conservative sampling; tune based on traffic and your Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
# Avoid sending user-identifying data unless there is a reviewed requirement.
SENTRY_SEND_DEFAULT_PII=False
