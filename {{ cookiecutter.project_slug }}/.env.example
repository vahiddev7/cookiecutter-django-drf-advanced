# .env.example

# Django settings
# -----------------------------------------------------------------------------
# SECURITY WARNING: keep the secret key used in production secret!
# Generate a strong secret key using: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# SECURITY WARNING: don't run with debug turned on in production!
# Set to True for development, False for production.
DEBUG=False

# Allowed hosts list for production. '*' is only for development.
# For production, specify your domain names, e.g., ALLOWED_HOSTS=example.com,www.example.com
ALLOWED_HOSTS=*


# Database settings
# -----------------------------------------------------------------------------
# Use SQLite for development, PostgreSQL or MySQL for production.
# Example for PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your_db_name
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Current setup uses SQLite, so these are commented out. Uncomment and configure
# them if you switch to a different database backend.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3  # Path is relative to BASE_DIR in settings.py


# Internationalization and Localization
# -----------------------------------------------------------------------------
# Language code for the site. 'fa' for Persian.
LANGUAGE_CODE=fa

# Time zone for the site. 'UTC' is standard, but you can use others like 'Asia/Tehran'.
TIME_ZONE=UTC


# Media and Static files
# -----------------------------------------------------------------------------
# Base directory for serving media files during development.
# In production, you'll likely use a dedicated service like AWS S3 or Nginx.
MEDIA_URL=
MEDIA_ROOT=  # This should be relative to BASE_DIR

# Base directory for serving static files during development.
# In production, you'll likely use a dedicated service or collectstatic.
STATIC_URL=
STATIC_ROOT=  # This should be relative to BASE_DIR


# Other settings
# -----------------------------------------------------------------------------
# User model. Ensure 'apps.users' is in INSTALLED_APPS.
AUTH_USER_MODEL=

# If using Channels for WebSockets, uncomment and configure:
# ASGI_APPLICATION=config.asgi.application

# If using Celery for background tasks, configure broker URL:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_ACCEPT_CONTENT = ['json']
# CELERY_TASK_SERIALIZER = 'json'
# CELERY_RESULT_SERIALIZER = 'json'
# CELERY_timezone = TIME_ZONE
