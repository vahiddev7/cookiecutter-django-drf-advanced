version: '3.9'

services:
  {% if cookiecutter.database_engine == 'postgresql' %}
  db:
    image: docker.arvancloud.ir/postgres:17
    container_name: {{ cookiecutter.project_slug }}_postgres
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_DB: ${DB_NAME}
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - {{ cookiecutter.project_slug }}_network

  {% elif cookiecutter.database_engine == 'mysql' %}
  db:
    image: mysql:8.0
    container_name: {{ cookiecutter.project_slug }}_mysql
    restart: unless-stopped
    ports:
      - "3306:3306"
    environment:
      MYSQL_DATABASE: ${DB_NAME}
      MYSQL_USER: ${DB_USER}
      MYSQL_PASSWORD: ${DB_PASSWORD}
      MYSQL_RANDOM_ROOT_PASSWORD: 'yes'
    volumes:
      - mysql_data:/var/lib/mysql
    networks:
      - {{ cookiecutter.project_slug }}_network

  {% elif cookiecutter.database_engine == 'sqlserver' %}
  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: {{ cookiecutter.project_slug }}_sqlserver
    restart: unless-stopped
    ports:
      - "1433:1433"
    environment:
      ACCEPT_EULA: "Y"
      MSSQL_SA_PASSWORD: ${DB_PASSWORD}
    volumes:
      - sqlserver_data:/var/opt/mssql
    networks:
      - {{ cookiecutter.project_slug }}_network
  {% endif %}

  app:
    build:
      context: .
      dockerfile: docker/production/Dockerfile
    container_name: {{ cookiecutter.project_slug }}_app
    restart: unless-stopped
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    {% if cookiecutter.database_engine != 'sqlite' %}
    depends_on:
      - db
    {% endif %}
    networks:
      - {{ cookiecutter.project_slug }}_network

  nginx:
    image: nginx:latest
    container_name: {{ cookiecutter.project_slug }}_nginx
    restart: unless-stopped
    ports:
      - "80:80"
      # - "443:443"
    volumes:
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
      # - ./nginx/certs:/etc/nginx/certs:ro
      - nginx_logs:/var/log/nginx
    depends_on:
      - app
    networks:
      - {{ cookiecutter.project_slug }}_network

  {% if cookiecutter.use_celery == 'y' %}
  {% if cookiecutter.celery_broker == 'redis' %}
  broker:
    image: redis:7-alpine
    container_name: {{ cookiecutter.project_slug }}_redis
    restart: unless-stopped
    networks:
      - {{ cookiecutter.project_slug }}_network
  {% elif cookiecutter.celery_broker == 'rabbitmq' %}
  broker:
    image: rabbitmq:3-management
    container_name: {{ cookiecutter.project_slug }}_rabbitmq
    restart: unless-stopped
    ports:
      - "15672:15672"
    networks:
      - {{ cookiecutter.project_slug }}_network
  {% endif %}

  worker:
    build:
      context: .
      dockerfile: docker/production/Dockerfile
    command: celery -A config worker -l info
    container_name: {{ cookiecutter.project_slug }}_celery_worker
    volumes:
      - .:/app
    {% if cookiecutter.database_engine != 'sqlite' %}
    depends_on:
      - db
      - broker
    {% else %}
    depends_on:
      - broker
    {% endif %}
    networks:
      - {{ cookiecutter.project_slug }}_network
  {% endif %}

volumes:
  {% if cookiecutter.database_engine == 'postgresql' %}
  postgres_data:
    driver: local
  {% elif cookiecutter.database_engine == 'mysql' %}
  mysql_data:
    driver: local
  {% elif cookiecutter.database_engine == 'sqlserver' %}
  sqlserver_data:
    driver: local
  {% endif %}
  nginx_logs:
    driver: local

networks:
  {{ cookiecutter.project_slug }}_network:
    driver: bridge